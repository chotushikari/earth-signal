# Copy to .env.local for local development. NEVER commit populated secrets.

# NASA Earthdata (server / Python worker only; never VITE_ prefixed)
EARTHDATA_TOKEN=

# Supabase (server-side)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase browser-safe publishable/anon key only if RLS is correct
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Mapping / terrain provider — only after licensing and plan approval
VITE_CESIUM_ION_TOKEN=

# App runtime
SCIENCE_WORKER_URL=http://127.0.0.1:8000
MAX_AOI_PIXELS=25000000
MAX_WORKER_CONCURRENCY=1
RESULT_RETENTION_DAYS=7

# Optional integrations remain disabled until separately approved
WORLDPOP_ENABLED=false
FIRMS_ENABLED=false
OSM_CONTEXT_ENABLED=false
GEOCODING_ENABLED=false
LLM_EXPLANATIONS_ENABLED=false
